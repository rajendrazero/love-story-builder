{
  "name": "website-for-kekasih",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm build && node scripts/dev-worker.mjs",
    "dev:https:untrusted": "pnpm build && node scripts/dev-worker.mjs --untrusted-https",
    "dev:http": "pnpm build && node scripts/dev-worker.mjs --http",
    "dev:ui": "nuxt dev",
    "build": "nuxt build",
    "test": "node --experimental-strip-types --test",
    "gmail:oauth": "node scripts/gmail-oauth.mjs",
    "preview": "pnpm dev",
    "check:worker": "node scripts/check-worker-config.mjs",
    "deploy": "pnpm build && pnpm check:worker && wrangler --cwd .output --config server/wrangler.json deploy server/index.mjs",
    "db:local": "wrangler d1 migrations apply kekasih-db --local",
    "db:remote": "wrangler d1 migrations apply kekasih-db --remote",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "gsap": "^3.14.0",
    "nuxt": "^4.6.3",
    "qrcode.vue": "^3.6.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "@nuxt/icon": "^2.6.2",
    "@rollup/plugin-terser": "1.0.2",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.10",
    "wrangler": "^4.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "glob@<14.0.2": "14.0.3",
      "minimatch@<11.0.1": "11.0.3"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
